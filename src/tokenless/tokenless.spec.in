%bcond_with anolisa_integration
%define anolis_release 2
%global debug_package %{nil}

Name:           tokenless
Version:        @VERSION@
Release:        %{anolis_release}%{?dist}
Summary:        LLM Token Optimization Toolkit - Schema/Response Compression + Command Rewriting + Tool Ready

# Tokenless and RTK are Apache-2.0; the statically linked toon-format
# library crate is MIT.
License:        Apache-2.0 AND MIT
URL:            https://github.com/alibaba/anolisa
Source0:        %{name}-%{version}.tar.gz

# Build dependencies
# Tokenless uses Rust 1.89; the separately built RTK requires Rust 1.91.
# Vendored RTK source is included in the tarball.
# Workspace deps (including the toon-format library) come from crates.io, so
# RPM build environments must configure a crates.io mirror (e.g. sparse+https://mirrors.aliyun.com/crates.io-index/).
BuildRequires:  cargo
BuildRequires:  rust >= 1.91
# nodejs/npm are required to compile the OpenClaw TS plugin -> dist/index.js
# via `make build-openclaw-plugin`. The native dsh bundle is plain ESM and is
# validated by `make build-dsh-plugin`. Provided by CI; declared here for chroot
# builds where they are not pre-installed.
BuildRequires:  nodejs
BuildRequires:  npm
# %build stamps the adapter templates through the Makefile, and the QwenPaw
# requirements pin asks packaging/raw/wheel-version.py for the PEP 440 spelling
# of the workspace version that wheel filenames carry. Provided by CI; declared
# here for chroot builds where it is not pre-installed.
BuildRequires:  python3

Requires:       tokenless-core = %{version}-%{release}
Requires:       tokenless-plugins = %{version}-%{release}
%description
Token-Less is an LLM token optimization toolkit that significantly reduces token
consumption through Schema/Response Compression, TOON Context Compression,
Command Rewriting, and Tool Ready environment pre-check strategies.

Core Features:
- Schema Compression: Compresses OpenAI Function Calling tool definitions
- Response Compression: Compresses API/tool responses (removes debug/null/empty)
- TOON Context Compression: Encodes JSON to TOON format, chained after response compression
- Command Rewriting: Filters CLI command output via RTK
- Tool Ready: Pre-execution environment check, auto-fix, and failure attribution
- Statistics Tracking: SQLite-based metrics for compression effectiveness

The package includes:
- tokenless: CLI tool for schema/response compression and TOON encoding
  (TOON is linked in via the crates.io toon-format library)
- rtk: High-performance CLI proxy for command rewriting (vendored source, Apache-2.0, excluded from workspace)

Note: OpenClaw plugin is available under /usr/share/anolisa/adapters/tokenless/openclaw/.
Native DeepSeek Harness (dsh) plugin bundle is available under
/usr/share/anolisa/adapters/tokenless/dsh/. Register it with
`anolisa adapter enable tokenless dsh --profile <profile>`.
Copilot-shell extension is auto-discovered from /usr/share/anolisa/extensions/tokenless/.
Hermes Agent plugin (response compression, TOON encoding, command rewriting via RTK,
and Tool Ready) is available under /usr/share/anolisa/adapters/tokenless/hermes/.
Run the install script to register with Hermes: hermes/scripts/install.sh
QwenPaw plugin (schema compression, response/TOON compression, command rewriting via RTK)
is available under /usr/share/anolisa/adapters/tokenless/qwenpaw/.
Run the install script to register with QwenPaw: qwenpaw/scripts/install.sh
Claude Code plugin (RTK command rewriting, response/TOON compression, and Tool Ready
environment pre-check) is available under /usr/share/anolisa/adapters/tokenless/claude-code/.
Register it with the official `claude plugin marketplace add` / `claude plugin install`
CLI, or run the install script: claude-code/scripts/install.sh
Qwen Code plugin (RTK command rewriting, response/TOON compression, and Tool Ready
environment pre-check) is available under /usr/share/anolisa/adapters/tokenless/qwencode/.
Register it with `qwen extensions link`, or run the install script: qwencode/scripts/install.sh
OpenCode plugin (schema/response/TOON compression, RTK command rewriting, and Tool
Ready) is available under /usr/share/anolisa/adapters/tokenless/opencode/.
Register it by running the install script: opencode/scripts/install.sh


%package -n tokenless-core
Summary:        Tokenless command-line tools and RTK
%if %{with anolisa_integration}
Provides:       anolisa-component(tokenless)
%endif
Conflicts:      tokenless < %{version}-%{release}
Requires:       bash

%description -n tokenless-core
Tokenless CLI, RTK and the shared runtime resources used by Tool Ready.

%package -n tokenless-plugins
Summary:        Tokenless native Agent integrations
BuildArch:      noarch
Conflicts:      tokenless < %{version}-%{release}
Requires:       tokenless-core = %{version}-%{release}
Requires:       python3
Requires:       nodejs >= 18
Requires:       jq
Requires:       bash

%description -n tokenless-plugins
Native plugins, hooks and shared scripts for the supported Agent frameworks.
QwenWork resources support macOS sideloading; carrying them does not add Linux host support.

%prep
%setup -q -n %{name}-%{version}

# rtk source in tarball is already patched (rtk-tokenless-stats.patch
# applied during tarball creation via justfile setup-rtk).

# Clean any stale build artifacts from the tarball
cargo clean --release

%build
# Build tokenless (rtk excluded from workspace — built separately)
cargo build --release
cargo build --release --locked --manifest-path third_party/rtk/Cargo.toml

# Compile the OpenClaw TS plugin via the project Makefile.
# Produces adapters/tokenless/openclaw/dist/index.js, which package.json
# declares as both "main" and openclaw.extensions. Mirroring sec-core's
# build-openclaw-plugin pattern — never hand-roll tsc/esbuild here.
make build-openclaw-plugin build-dsh-plugin

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}%{_bindir}
mkdir -p %{buildroot}%{_libexecdir}/anolisa/tokenless
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/common/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/common/commands
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/openclaw/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/openclaw/dist
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/dsh/dist
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/hermes/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qoder/.qoder-plugin
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qoder/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qoder/commands
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qoder/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/.qoder-plugin
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/shared
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/claude-code/.claude-plugin
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/claude-code/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/claude-code/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/codex/.codex-plugin
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/codex/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/opencode/scripts
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwencode/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/qwencode/scripts
mkdir -p %{buildroot}%{_docdir}/tokenless

# Install binaries — tokenless (user-facing) to /usr/bin, helpers to /usr/libexec/anolisa/tokenless
install -m 0755 target/release/tokenless %{buildroot}%{_bindir}/tokenless
install -m 0755 third_party/rtk/target/release/rtk %{buildroot}%{_libexecdir}/anolisa/tokenless/rtk

# Create a symlink so rtk is discoverable via PATH
ln -sf %{_libexecdir}/anolisa/tokenless/rtk %{buildroot}%{_bindir}/rtk

# Install documentation. The bilingual user manual moved to the
# repository-level docs/user-guide tree and is published with the ANOLISA
# documentation, not packaged per-component.
install -m 0644 docs/response-compression.md %{buildroot}%{_docdir}/tokenless/
install -m 0644 LICENSE %{buildroot}%{_docdir}/tokenless/

# Install adapter bundle (common hooks/spec + openclaw)
install -m 0644 adapters/tokenless/manifest.json %{buildroot}%{_datadir}/tokenless/adapters/
# Install the tokenless RPM component contract (publishing/plugin metadata)
# at the component-level path declared by the ANOLISA component-contract
# model: %{_datadir}/anolisa/components/<component>/component.toml.
%if %{with anolisa_integration}
install -d -m 0755 %{buildroot}%{_datadir}/anolisa/components/tokenless
install -m 0644 .anolisa/component.toml %{buildroot}%{_datadir}/anolisa/components/tokenless/
%endif
install -m 0644 adapters/tokenless/common/tool-ready-spec.json %{buildroot}%{_datadir}/tokenless/adapters/common/
install -m 0755 adapters/tokenless/common/tokenless-env-fix.sh %{buildroot}%{_datadir}/tokenless/adapters/common/
install -m 0644 adapters/tokenless/common/cosh-extension.json %{buildroot}%{_datadir}/tokenless/adapters/common/
install -m 0755 adapters/tokenless/common/hooks/*.py %{buildroot}%{_datadir}/tokenless/adapters/common/hooks/
install -m 0755 adapters/tokenless/common/hooks/*.sh %{buildroot}%{_datadir}/tokenless/adapters/common/hooks/
install -m 0644 adapters/tokenless/common/hooks/tool_categories.json %{buildroot}%{_datadir}/tokenless/adapters/common/hooks/
install -m 0644 adapters/tokenless/common/commands/tokenless-stats.toml %{buildroot}%{_datadir}/tokenless/adapters/common/commands/
install -m 0755 adapters/tokenless/openclaw/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/openclaw/scripts/
install -m 0755 adapters/tokenless/openclaw/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/openclaw/scripts/
install -m 0755 adapters/tokenless/openclaw/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/openclaw/scripts/
# Install the compiled dist tree produced by `make build-openclaw-plugin`.
# package.json declares main/openclaw.extensions = ./dist/index.js; OpenClaw
# `plugins install` reads from this directory and requires dist/index.js to exist.
install -m 0644 adapters/tokenless/openclaw/dist/index.js %{buildroot}%{_datadir}/tokenless/adapters/openclaw/dist/
install -m 0644 adapters/tokenless/openclaw/openclaw.plugin.json %{buildroot}%{_datadir}/tokenless/adapters/openclaw/
install -m 0644 adapters/tokenless/openclaw/package.json %{buildroot}%{_datadir}/tokenless/adapters/openclaw/

# Install the native dsh bundle. dsh owns profile mutation; this package only
# ships the immutable package manifest, Cordis patch, and plugin entry.
install -m 0644 adapters/tokenless/dsh/package.json %{buildroot}%{_datadir}/tokenless/adapters/dsh/
install -m 0644 adapters/tokenless/dsh/cordis.patch.yml %{buildroot}%{_datadir}/tokenless/adapters/dsh/
install -m 0644 adapters/tokenless/dsh/dist/index.js %{buildroot}%{_datadir}/tokenless/adapters/dsh/dist/

# Install Hermes Agent plugin (Python hooks + install scripts)
install -m 0755 adapters/tokenless/hermes/__init__.py %{buildroot}%{_datadir}/tokenless/adapters/hermes/
install -m 0644 adapters/tokenless/hermes/plugin.yaml %{buildroot}%{_datadir}/tokenless/adapters/hermes/
install -m 0755 adapters/tokenless/hermes/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/hermes/scripts/
install -m 0755 adapters/tokenless/hermes/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/hermes/scripts/
install -m 0755 adapters/tokenless/hermes/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/hermes/scripts/

# Install QwenPaw plugin (AgentScope middleware + install scripts). The
# anolisa_tokenless wheel is pulled by QwenPaw from requirements.txt.
install -m 0755 adapters/tokenless/qwenpaw/plugin.py %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/
install -m 0644 adapters/tokenless/qwenpaw/plugin.json %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/
install -m 0644 adapters/tokenless/qwenpaw/requirements.txt %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/
install -m 0755 adapters/tokenless/qwenpaw/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/scripts/
install -m 0755 adapters/tokenless/qwenpaw/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/scripts/
install -m 0755 adapters/tokenless/qwenpaw/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenpaw/scripts/

# Install the native Qoder CLI plugin. The wrapper resolves implementation
# scripts from common/hooks/ so the hook logic remains shared.
install -m 0644 adapters/tokenless/qoder/.qoder-plugin/plugin.json %{buildroot}%{_datadir}/tokenless/adapters/qoder/.qoder-plugin/
install -m 0644 adapters/tokenless/qoder/hooks/hooks.json %{buildroot}%{_datadir}/tokenless/adapters/qoder/hooks/
install -m 0755 adapters/tokenless/qoder/hooks/run-hook.sh %{buildroot}%{_datadir}/tokenless/adapters/qoder/hooks/
install -m 0644 adapters/tokenless/qoder/commands/tokenless-stats.md %{buildroot}%{_datadir}/tokenless/adapters/qoder/commands/
install -m 0755 adapters/tokenless/qoder/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/qoder/scripts/
install -m 0755 adapters/tokenless/qoder/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/qoder/scripts/
install -m 0755 adapters/tokenless/qoder/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/qoder/scripts/

# Ship QwenWork resources only; macOS sideloading is an explicit user action.
# Materialize shared hooks so a copied native plugin has no external symlinks.
install -m 0644 adapters/tokenless/qwenwork/.qoder-plugin/plugin.json %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/.qoder-plugin/
install -m 0644 adapters/tokenless/qwenwork/hooks/hooks.json %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/
install -m 0755 adapters/tokenless/qwenwork/hooks/run-hook.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/
install -m 0755 adapters/tokenless/common/hooks/*.py %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/shared/
install -m 0755 adapters/tokenless/common/hooks/*.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/shared/
install -m 0644 adapters/tokenless/common/hooks/*.json %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/hooks/shared/
install -m 0755 adapters/tokenless/qwenwork/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/scripts/
install -m 0755 adapters/tokenless/qwenwork/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/scripts/
install -m 0755 adapters/tokenless/qwenwork/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/scripts/
install -m 0755 adapters/tokenless/qwenwork/scripts/lifecycle.py %{buildroot}%{_datadir}/tokenless/adapters/qwenwork/scripts/

# Install Claude Code plugin (marketplace + plugin manifest + wrapper hook + scripts).
# plugin.json is stamped from .in by `make stamp-adapter-templates` during %build
# (transitive dep of build-openclaw-plugin); shipped as a regular file here.
install -m 0644 adapters/tokenless/claude-code/.claude-plugin/marketplace.json %{buildroot}%{_datadir}/tokenless/adapters/claude-code/.claude-plugin/
install -m 0644 adapters/tokenless/claude-code/.claude-plugin/plugin.json %{buildroot}%{_datadir}/tokenless/adapters/claude-code/.claude-plugin/
install -m 0644 adapters/tokenless/claude-code/hooks/hooks.json %{buildroot}%{_datadir}/tokenless/adapters/claude-code/hooks/
install -m 0755 adapters/tokenless/claude-code/hooks/run-hook.sh %{buildroot}%{_datadir}/tokenless/adapters/claude-code/hooks/
install -m 0755 adapters/tokenless/claude-code/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/claude-code/scripts/
install -m 0755 adapters/tokenless/claude-code/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/claude-code/scripts/
install -m 0755 adapters/tokenless/claude-code/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/claude-code/scripts/

# Install Codex plugin (manifest + hooks.json + install scripts + Python hooks).
install -m 0644 adapters/tokenless/codex/.codex-plugin/plugin.json %{buildroot}%{_datadir}/tokenless/adapters/codex/.codex-plugin/
install -m 0644 adapters/tokenless/codex/hooks/hooks.json %{buildroot}%{_datadir}/tokenless/adapters/codex/hooks/
install -m 0755 adapters/tokenless/codex/scripts/check-tokenless %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/response-diagnostics %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/rewrite-hook %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/tool-ready %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0755 adapters/tokenless/codex/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/
install -m 0644 adapters/tokenless/codex/scripts/_common.sh %{buildroot}%{_datadir}/tokenless/adapters/codex/scripts/

# Install OpenCode plugin (local JavaScript plugin + lifecycle scripts).
install -m 0644 adapters/tokenless/opencode/plugin.js %{buildroot}%{_datadir}/tokenless/adapters/opencode/
install -m 0755 adapters/tokenless/opencode/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/opencode/scripts/
install -m 0755 adapters/tokenless/opencode/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/opencode/scripts/
install -m 0755 adapters/tokenless/opencode/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/opencode/scripts/

# Install Qwen Code plugin (extension manifest + hooks + scripts).
# qwen-extension.json is stamped from .in by `make stamp-adapter-templates`
# during %build (transitive dep of build-openclaw-plugin).
install -m 0644 adapters/tokenless/qwencode/qwen-extension.json %{buildroot}%{_datadir}/tokenless/adapters/qwencode/
install -m 0755 adapters/tokenless/qwencode/hooks/run-hook.sh %{buildroot}%{_datadir}/tokenless/adapters/qwencode/hooks/
install -m 0755 adapters/tokenless/qwencode/scripts/detect.sh %{buildroot}%{_datadir}/tokenless/adapters/qwencode/scripts/
install -m 0755 adapters/tokenless/qwencode/scripts/install.sh %{buildroot}%{_datadir}/tokenless/adapters/qwencode/scripts/
install -m 0755 adapters/tokenless/qwencode/scripts/uninstall.sh %{buildroot}%{_datadir}/tokenless/adapters/qwencode/scripts/

# Install cosh extension for auto-discovery at /usr/share/anolisa/extensions/tokenless/
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/cosh/hooks
mkdir -p %{buildroot}%{_datadir}/tokenless/adapters/cosh/commands
install -m 0644 adapters/tokenless/common/cosh-extension.json %{buildroot}%{_datadir}/tokenless/adapters/cosh/
install -m 0644 adapters/tokenless/common/tool-ready-spec.json %{buildroot}%{_datadir}/tokenless/adapters/cosh/
install -m 0755 adapters/tokenless/common/tokenless-env-fix.sh %{buildroot}%{_datadir}/tokenless/adapters/cosh/
install -m 0755 adapters/tokenless/common/hooks/*.py %{buildroot}%{_datadir}/tokenless/adapters/cosh/hooks/
install -m 0755 adapters/tokenless/common/hooks/*.sh %{buildroot}%{_datadir}/tokenless/adapters/cosh/hooks/
install -m 0644 adapters/tokenless/common/hooks/tool_categories.json %{buildroot}%{_datadir}/tokenless/adapters/cosh/hooks/
install -m 0644 adapters/tokenless/common/commands/tokenless-stats.toml %{buildroot}%{_datadir}/tokenless/adapters/cosh/commands/

install -d %{buildroot}%{_datadir}/anolisa/adapters
cp -rp %{buildroot}%{_datadir}/tokenless/adapters %{buildroot}%{_datadir}/anolisa/adapters/tokenless

install -d %{buildroot}%{_datadir}/anolisa/extensions
cp -rp %{buildroot}%{_datadir}/tokenless/adapters/cosh %{buildroot}%{_datadir}/anolisa/extensions/tokenless

%files
%license LICENSE

%files -n tokenless-core
%license LICENSE
%{_bindir}/tokenless
%{_bindir}/rtk
%{_libexecdir}/anolisa/tokenless/
%if %{with anolisa_integration}
%{_datadir}/anolisa/components/tokenless/
%endif
%{_datadir}/tokenless/adapters/common/tool-ready-spec.json
%{_datadir}/tokenless/adapters/common/tokenless-env-fix.sh
%{_datadir}/anolisa/adapters/tokenless/common/tool-ready-spec.json
%{_datadir}/anolisa/adapters/tokenless/common/tokenless-env-fix.sh
%doc %{_docdir}/tokenless/

%files -n tokenless-plugins
%license LICENSE
%{_datadir}/tokenless/adapters/
%exclude %{_datadir}/tokenless/adapters/common/tool-ready-spec.json
%exclude %{_datadir}/tokenless/adapters/common/tokenless-env-fix.sh
%{_datadir}/anolisa/adapters/tokenless/
%exclude %{_datadir}/anolisa/adapters/tokenless/common/tool-ready-spec.json
%exclude %{_datadir}/anolisa/adapters/tokenless/common/tokenless-env-fix.sh
%{_datadir}/anolisa/extensions/tokenless

