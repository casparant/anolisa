{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/agent-sec-core/aw-provider/request/v1",
  "title": "agent-sec-cli aw-provider native request v1",
  "description": "One request read from standard input. All three Capabilities in this package share one executable, so the requested operation arrives here rather than on the command line.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operation", "content"],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "operation": {
      "enum": ["content_inspect", "code_inspect", "command_inspect"]
    },
    "content": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "include_low_confidence": {
      "type": "boolean"
    },
    "language": {
      "enum": ["auto", "bash", "python"]
    }
  }
}
