{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/agent-sec-core/aw-provider/response/v1",
  "title": "agent-sec-cli aw-provider native response v1",
  "description": "One response written to standard output. findings_total and scanned_bytes are required in every disposition because the Provider Host resolves every declared meter pointer regardless of disposition. No field carries matched content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "disposition",
    "findings_total",
    "scanned_bytes",
    "truncated"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "disposition": {
      "enum": ["completed", "skipped", "error"]
    },
    "findings_total": {
      "type": "integer",
      "minimum": 0
    },
    "scanned_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "clean",
        "suspicious",
        "sensitive",
        "allow",
        "warn",
        "deny"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "category",
          "severity",
          "confidence",
          "count"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{1,64}$"
          },
          "category": {
            "enum": [
              "secret",
              "personal_data",
              "credential",
              "dangerous_pattern",
              "obfuscation",
              "other"
            ]
          },
          "severity": {
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "confidence": {
            "enum": ["low", "medium", "high"]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9._-]{1,64}$"
      }
    },
    "language_detected": {
      "enum": ["bash", "python", "unknown"]
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
