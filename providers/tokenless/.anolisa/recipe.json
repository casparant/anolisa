{
  "build": {
    "package_id": "aw-provider-tokenless",
    "source": "providers/tokenless",
    "version_file": "providers/tokenless/Cargo.toml",
    "version_key": "package.version",
    "builder": "cargo",
    "binary": "aw-provider-tokenless",
    "dependencies": [
      "aw-core",
      "tokenless"
    ],
    "provider": true,
    "entrypoints": {},
    "required": [
      "libexec/aw/providers/tokenless/aw-provider-tokenless",
      "share/aw/providers/tokenless/examples/aw.yaml"
    ]
  },
  "schema_version": 1,
  "id": "aw-provider-tokenless",
  "source_dir": "providers/tokenless",
  "resource_namespace": "aw",
  "rpm_spec": "providers/tokenless/packaging/rpm/aw-provider-tokenless.spec.in",
  "packages": [
    {
      "id": "aw-provider-tokenless",
      "kind": "provider",
      "requires": [
        "aw-core",
        "tokenless-core"
      ],
      "sources": [
        {
          "from": "libexec/aw/providers/tokenless/",
          "to": "libexec/aw/providers/tokenless/"
        },
        {
          "from": "share/aw/providers/tokenless/",
          "to": "share/aw/providers/tokenless/"
        },
        {
          "from": "share/doc/aw-provider-tokenless/",
          "to": "share/doc/aw-provider-tokenless/"
        }
      ]
    }
  ]
}
