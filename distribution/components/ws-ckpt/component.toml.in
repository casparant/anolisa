manifest_version = 2

[component]
name = "ws-ckpt"
version = "0.6.0"
layer = "runtime"
domain = "state"
display_name = "Workspace Checkpoint"
description = "Workspace checkpoint - btrfs COW session-level isolation and rollback"
owner = "ws-ckpt-team"
license = "Apache-2.0"
repository = "https://github.com/agentic-os-org/ANOLISA"

[component.contract]
schema_version = "1.0"
min_anolisa_version = "0.3.19"

[backends.rpm]
package = "ws-ckpt"

[component.platform]
os = ["linux"]
arch = ["x86_64", "aarch64"]
min_kernel = "5.4"

[[component.dependencies]]
name = "btrfs-progs"
kind = "system-package"
probe = "mkfs.btrfs --version"
packages = { rpm = "btrfs-progs", deb = "btrfs-progs" }

[[component.dependencies]]
name = "rsync"
kind = "system-package"
probe = "rsync --version"
packages = { rpm = "rsync", deb = "rsync" }

[[component.dependencies]]
name = "btrfs"
kind = "platform-capability"
check = "btrfs"
min_kernel = "5.4"

[component.layout]
modes = ["system"]

[[component.layout.files]]
source = ".anolisa/component.toml"
target = "{datadir}/components/ws-ckpt/component.toml"
mode = "0644"

[[component.layout.files]]
source = "bin/ws-ckpt"
target = "{bindir}/ws-ckpt"
mode = "0755"
type = "executable"

[[component.layout.files]]
source = "share/ws-ckpt/skills/ws-ckpt/"
target = "{sharedir}/ws-ckpt/skills/ws-ckpt"

[[component.layout.files]]
source = "share/ws-ckpt/templates/ws-ckpt.service"
target = "{unitdir}/ws-ckpt.service"
mode = "0644"

[[component.layout.files]]
source = "share/ws-ckpt/templates/config.toml.sample"
target = "{sharedir}/ws-ckpt/templates/config.toml.sample"
mode = "0644"
type = "config"

[[component.layout.files]]
source = "share/ws-ckpt/hooks/pre-uninstall.sh"
target = "{sharedir}/ws-ckpt/hooks/pre-uninstall.sh"
mode = "0755"
type = "executable"

[[component.layout.files]]
source = "share/ws-ckpt/adapters/manifest.json"
target = "{sharedir}/ws-ckpt/adapters/manifest.json"
mode = "0644"

[[component.services]]
unit = "ws-ckpt.service"
scope = "system"
enable = false
start = false

[[component.hooks]]
phase = "pre_uninstall"
script = "{sharedir}/ws-ckpt/hooks/pre-uninstall.sh"
timeout_secs = 300
strict = false

[component.health_check]
type = "binary_version"
binary = "{bindir}/ws-ckpt"
timeout_secs = 5

[[adapters]]
framework = "openclaw"
name = "ws-ckpt-openclaw"
display_name = "ws-ckpt for OpenClaw"
adapter_type = "plugin"
trust = "first-party"
plugin_id = "ws-ckpt"
source = "share/ws-ckpt/adapters/openclaw"
dest = "{sharedir}/ws-ckpt/adapters/openclaw/"
detect = { binary = "openclaw" }

[adapters.compat]
framework_version = ">=2026.2.13"

[adapters.bundle]
schema = 1
entry = "openclaw.plugin.json"

[adapters.openclaw.bundle]
schema = 1
entry = "openclaw.plugin.json"

[[adapters]]
framework = "hermes"
name = "ws-ckpt-hermes"
display_name = "ws-ckpt for Hermes"
adapter_type = "plugin"
trust = "first-party"
plugin_id = "ws-ckpt"
source = "share/ws-ckpt/adapters/hermes"
dest = "{sharedir}/ws-ckpt/adapters/hermes/"
detect = { binary = "hermes" }

[adapters.bundle]
schema = 1
entry = "plugin.yaml"

[adapters.hermes.bundle]
schema = 1
entry = "plugin.yaml"
