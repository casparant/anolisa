manifest_version = 2
anolisa_min_version = "0.3.19"

[component]
name = "os-skills"
version = "0.6.3"
layer = "runtime"
domain = "tools"
description = "Curated OS Skill library for agent runtimes"

[install]
modes = ["user", "system"]

[backends.rpm]
package = "os-skills"

[[adapters]]
framework = "openclaw"
name = "os-skills-openclaw"
display_name = "OS Skills for OpenClaw"
adapter_type = "skill_bundle"
source = ".anolisa"
trust = "first-party"
dest = "{sharedir}/os-skills/adapters/openclaw"
detect = { binary = "openclaw" }

[[adapters.openclaw.skills]]
name = "qwenpaw-usage"
source = "{sharedir}/os-skills/skills/qwenpaw-usage/"

[[adapters.openclaw.skills]]
name = "install-claude-code"
source = "{sharedir}/os-skills/skills/install-claude-code/"

[[adapters.openclaw.skills]]
name = "install-qwenpaw"
source = "{sharedir}/os-skills/skills/install-qwenpaw/"

[[adapters.openclaw.skills]]
name = "install-hermes"
source = "{sharedir}/os-skills/skills/install-hermes/"

[[adapters.openclaw.skills]]
name = "install-openclaw"
source = "{sharedir}/os-skills/skills/install-openclaw/"

[[adapters.openclaw.skills]]
name = "install-tokenless"
source = "{sharedir}/os-skills/skills/install-tokenless/"

[[adapters.openclaw.skills]]
