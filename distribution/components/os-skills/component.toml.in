[component.platform]
os = ["linux"]
arch = ["x86_64", "aarch64"]

[component.contract]
schema_version = "1.0"
min_anolisa_version = "0.3.19"

[component.layout]
modes = ["user", "system"]

[[component.layout.files]]
source = ".anolisa/component.toml"
target = "{datadir}/components/os-skills/component.toml"
mode = "0644"

[[component.layout.files]]
source = "share/os-skills/skills/"
target = "{sharedir}/os-skills/skills"

[[component.layout.files]]
source = "share/os-skills/adapters/manifest.json"
target = "{sharedir}/os-skills/adapters/manifest.json"
mode = "0644"
