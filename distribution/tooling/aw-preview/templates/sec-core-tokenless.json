{
  "format": 1,
  "packages": [
    "aw-provider-sec-core",
    "aw-provider-tokenless"
  ],
  "constraints": [
    {
      "kind": "unix_socket",
      "value": "${SOCKET}"
    },
    {
      "kind": "search_path",
      "value": "${PREFIX}/libexec/aw/providers/tokenless"
    }
  ],
  "providers": {
    "security": {
      "protocol": "aw-provider/v1alpha1",
      "transport": {
        "type": "stdio",
        "location": "agent",
        "argv": [
          "${PREFIX}/libexec/aw/providers/sec-core/aw-provider-sec-core",
          "--cli",
          "${PREFIX}/libexec/aw/providers/sec-core/agent-sec-cli",
          "--socket",
          "${SOCKET}"
        ]
      },
      "timeout_ms": 2000,
      "max_output_bytes": 4096,
      "config": {
        "version": 1,
        "mode": "block",
        "tools": {
          "Bash": {
            "language": "bash",
            "input_pointer": "/command"
          },
          "exec": {
            "language": "bash",
            "input_pointer": "/command"
          }
        }
      }
    },
    "tokenless": {
      "protocol": "aw-provider/v1alpha1",
      "transport": {
        "type": "stdio",
        "location": "agent",
        "argv": [
          "${PREFIX}/libexec/aw/providers/tokenless/aw-provider-tokenless",
          "--cli",
          "${PREFIX}/libexec/aw/providers/tokenless/tokenless",
          "--data-dir",
          "${STATE}/tokenless",
          "--rtk",
          "${PREFIX}/libexec/aw/providers/tokenless/rtk",
          "--rtk-sha256",
          "${RTK_SHA256}"
        ]
      },
      "timeout_ms": 2000,
      "max_output_bytes": 1048576,
      "config": {
        "version": 1
      },
      "view": {
        "protocol": "aw-provider-view/v1alpha1",
        "implementation": "tokenless",
        "transport": {
          "type": "stdio",
          "location": "agent",
          "argv": [
            "${PREFIX}/libexec/aw/providers/tokenless/aw-provider-tokenless",
            "--view",
            "--cli",
            "${PREFIX}/libexec/aw/providers/tokenless/tokenless",
            "--data-dir",
            "${STATE}/tokenless"
          ]
        }
      }
    }
  },
  "events": {
    "tool.before": {
      "enabled": true,
      "required": true,
      "steps": [
        {
          "id": "scan-code",
          "provider": "security",
          "operation": "scan_code",
          "effects": [
            "observe",
            "block"
          ],
          "on_error": "block"
        },
        {
          "id": "rewrite-command",
          "provider": "tokenless",
          "operation": "pre_tool",
          "effects": [
            "block"
          ],
          "on_error": "report"
        }
      ]
    },
    "tool.after": {
      "enabled": true,
      "required": true,
      "steps": [
        {
          "id": "observe-completion",
          "provider": "security",
          "operation": "observe_tool",
          "effects": [
            "observe"
          ],
          "on_error": "report"
        },
        {
          "id": "compress-result",
          "provider": "tokenless",
          "operation": "post_tool",
          "effects": [
            "replace_result"
          ],
          "on_error": "report"
        }
      ]
    }
  },
  "file_hashes": {
    "RTK_SHA256": {
      "package": "aw-provider-tokenless",
      "path": "libexec/aw/providers/tokenless/rtk"
    }
  }
}
